# Dad-Bot local development template
# Copy to .env (ignored by git) and fill values for your machine.

WORKSPACE_ROOT=.
OLLAMA_HOST=http://localhost:11434

POSTGRES_DB=dadbot
POSTGRES_USER=dadbot
POSTGRES_PASSWORD=change_me_local_dev

DADBOT_LLM_MODEL=qwen3.5:9b
# -1 keeps chat models resident; 300 restores a five-minute idle timeout.
DADBOT_OLLAMA_KEEP_ALIVE_SECONDS=-1
# auto preserves the model default; false disables thinking for ordinary chat.
# Explicit per-call settings still win. Planning/safety/reflection are unchanged.
DADBOT_OLLAMA_CHAT_THINK=auto
# auto follows snapshot-service settings; sqlite selects local derived indexes
# without changing PostgreSQL snapshot persistence.
DADBOT_MEMORY_INDEX_BACKEND=auto

# Optional execution-receipt key rotation: retain old keys only while pending
# durable loops may still need recovery. Values are UTF-8 strings of 32+ bytes.
# DADBOT_RECEIPT_KEY=
# DADBOT_RECEIPT_VERIFY_KEYS=[]

# Optional live avatar surface (for Spatial Agent frontend embed)
# Example: http://localhost:8080/index.html
DADBOT_SPATIAL_AVATAR_URL=

# Optional websocket relay URL injected into the avatar iframe query string.
# Example: ws://127.0.0.1:8787/v1/spatial/ws
DADBOT_SPATIAL_RELAY_WS_URL=
