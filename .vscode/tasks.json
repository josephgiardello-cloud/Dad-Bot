{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Test Lane: DEV",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"-m",
				"pytest",
				"-m",
				"unit",
				"--durations=15",
				"-q"
			],
			"group": "test"
		},
		{
			"label": "Test Lane: INTEGRATION",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"-m",
				"pytest",
				"-m",
				"integration",
				"-q"
			],
			"group": "test"
		},
		{
			"label": "Test Lane: THIN-SPINE VS LEGACY",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"-m",
				"pytest",
				"tests/integration/test_thin_spine_legacy_comparison.py",
				"-q"
			],
			"group": "test"
		},
		{
			"label": "Test Lane: DURABILITY / PHASE4",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"-m",
				"pytest",
				"-m",
				"durability or phase4",
				"--durations=15",
				"-q"
			],
			"group": "test"
		},
		{
			"label": "Test Lane: SOAK",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"-m",
				"pytest",
				"-m",
				"soak",
				"-q"
			],
			"group": "test"
		},
		{
			"label": "Test Lane: DETERMINISM STRESS",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"-m",
				"pytest",
				"--run-stress",
				"-m",
				"stress",
				"--durations=20",
				"-q"
			],
			"group": "test"
		},
		{
			"label": "Test Lane: STABILITY SWEEP",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"-m",
				"pytest",
				"--run-stress",
				"-m",
				"durability or phase4 or stress",
				"--durations=25",
				"-q"
			],
			"group": "test"
		},
		{
			"label": "Test Lane: UI",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"-m",
				"pytest",
				"-m",
				"ui",
				"-q"
			],
			"group": "test"
		},
		{
			"label": "Test Lane: CERT / REGRESSION",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"tools/cert_baseline_capture.py",
				"--durations",
				"20",
				"--write-baseline",
				"--report-markdown"
			],
			"group": "test"
		},
		{
			"label": "Test Lane: FULL CERT",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"-m",
				"pytest",
				"-q"
			],
			"group": "test"
		},
		{
			"label": "Run Dad Bot",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"Dad.py",
				"--model",
				"qwen3.5:9b"
			],
			"options": {
				"env": {
					"DADBOT_LLM_MODEL": "qwen3.5:9b"
				}
			},
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Run Dad Bot API (Spatial Relay)",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"Dad.py",
				"--api",
				"--api-host",
				"127.0.0.1",
				"--api-port",
				"8787"
			],
			"options": {
				"env": {
					"DADBOT_API_AUTH_REQUIRED": "0",
					"DADBOT_API_TOKEN_SECRET": "dev-local-token-secret-1234567890-abcdef",
					"DADBOT_POSTGRES_DSN": " ",
					"DADBOT_REDIS_URL": " "
				}
			},
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Run Dad Bot UI (Spatial Embed)",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"-m",
				"streamlit",
				"run",
				"dad_streamlit.py",
				"--server.port",
				"8501"
			],
			"options": {
				"env": {
					"DADBOT_SPATIAL_AVATAR_URL": "http://127.0.0.1:8080/index.html",
					"DADBOT_SPATIAL_RELAY_WS_URL": "ws://127.0.0.1:8787/v1/spatial/ws"
				}
			},
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Run Spatial Live Mock Frontend",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"-m",
				"http.server",
				"8080",
				"--directory",
				"static/spatial_live_mock"
			],
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Run Dad Bot Spatial Stack",
			"dependsOrder": "parallel",
			"dependsOn": [
				"Run Spatial Live Mock Frontend",
				"Run Dad Bot UI (Spatial Embed)",
				"Run Dad Bot API (Spatial Relay)"
			],
			"group": "build"
		},
		{
			"label": "Run Dad Bot MCP Server",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"-m",
				"dadbot_system.local_mcp_server"
			],
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Run Sovereign Heartbeat Daemon",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"Dad.py",
				"heartbeat-daemon",
				"--interval-seconds",
				"60",
				"--consolidation-interval-seconds",
				"300"
			],
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Run HUD Watch",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"Dad.py",
				"hud",
				"--interval-seconds",
				"2"
			],
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Contract Gate: STRICT",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"_ci_gate_check.py",
				"--contract-gate"
			],
			"group": "test"
		},
		{
			"label": "Inspect: System Health",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"tools/inspect_system.py",
				"--health"
			],
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Inspect: Tool Capabilities",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"tools/inspect_system.py",
				"--tools"
			],
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Inspect: Last Scale Report",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"tools/inspect_system.py",
				"--last-report"
			],
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Inspect: Invariant Violations",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"tools/inspect_system.py",
				"--violations"
			],
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "System: Scale Validation (10k)",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"tools/system_validation_at_scale.py",
				"--turns",
				"10000"
			],
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "System: Scale Validation + Recovery",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"tools/system_validation_at_scale.py",
				"--turns",
				"1000",
				"--include-unstable-recovery"
			],
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Git status tasks file",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short",
				".vscode/tasks.json"
			],
			"isBackground": false
		},
		{
			"label": "Stage tasks reconciliation",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				".vscode/tasks.json"
			],
			"isBackground": false
		},
		{
			"label": "Commit tasks reconciliation",
			"type": "shell",
			"command": "git",
			"args": [
				"commit",
				"-m",
				"Reconcile tasks with baseline: mark scanner convergence fix complete",
				".vscode/tasks.json"
			],
			"isBackground": false
		}
	]
}
